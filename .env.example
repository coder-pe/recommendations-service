PORT=8088
CONTEXT_PATH=/recommendations
API_BASE_PATH=/api/v1

CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

# JWT Authentication (protects /users/:userId/home and /feedback).
# When JWT_ENABLED=true, JWT_SECRET_KEY is required or the service refuses to start.
JWT_ENABLED=true
# Must match users-auth-service JWT secret (token validation)
JWT_SECRET_KEY=REPLACE_WITH_SHARED_JWT_SECRET_SAME_AS_USERS_AUTH

KAFKA_ENABLED=true
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_GROUP_ID=recommendations-service
KAFKA_TOPIC_USER_REGISTERED=qhato.users.user_registered
KAFKA_TOPIC_PRODUCT_CREATED=qhato.catalog.product.created
KAFKA_TOPIC_PRODUCT_UPDATED=qhato.catalog.product.updated
KAFKA_TOPIC_STORE_PRODUCT_UPSERT=qhato.inventory.store_product.upsert
KAFKA_TOPIC_RESERVATION_STATUS_CHANGED=qhato.reservations.status_changed
KAFKA_TOPIC_FEEDBACK=qhato.recommendations.feedback
KAFKA_TOPIC_DLQ=qhato.recommendations.dlq
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_BASE_MS=500

GORSE_ENABLED=true
GORSE_ENDPOINT=http://127.0.0.1:8089
GORSE_API_KEY=REPLACE_WITH_GORSE_API_KEY
GORSE_RECOMMEND_DEFAULT_N=20
GORSE_TIMEOUT_SECONDS=5

TENANT_NAMESPACE_ENABLED=true

IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_REDIS_URL=redis://127.0.0.1:6379/5
IDEMPOTENCY_TTL_HOURS=168
IDEMPOTENCY_KEY_PREFIX=qhato:recommendations:ingest
IDEMPOTENCY_SKIP_IF_NO_EVENT_ID=false

CONTRACT_REQUIRE_EVENT_ID=true
CONTRACT_REQUIRE_EVENT_VERSION=true
